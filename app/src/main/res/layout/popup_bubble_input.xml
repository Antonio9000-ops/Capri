<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#FFFFFF"
    android:padding="8dp" android:elevation="8dp">

    <EditText android:id="@+id/edit_input"
        android:layout_width="240dp" android:layout_height="wrap_content"
        android:hint="Pregúntale a Capri..." android:maxLines="2"
        android:inputType="text"
        android:textColor="#000000"
        android:textColorHint="#888888" />

    <Button android:id="@+id/btn_send"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="end" android:text="Enviar" />
</LinearLayout>
